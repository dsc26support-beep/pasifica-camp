# =============================================================================
# Pasifika Campus — Environment Variables (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and fill in your Supabase project values.
# NEVER commit a real .env file. NEVER put the service-role key in the app.
#
# Only the ANON (publishable) key belongs in the mobile app — Row Level
# Security is what protects your data. The service-role key must only ever be
# used from trusted server-side contexts (migrations, admin scripts), never
# bundled into the Expo client.
# =============================================================================

# Public Supabase project URL (safe to ship in the client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to ship in the client — RLS enforces access)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY — do NOT prefix with EXPO_PUBLIC_ and do NOT use in the app.
# Used only for local migrations / admin tooling.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=keep-this-secret-server-side-only
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
